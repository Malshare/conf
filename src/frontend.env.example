# === Database ===
# The compose stack runs MySQL 8.0.31 as the `mysql` service; the frontend and
# pymalshare services reach it over the compose network on host `mysql`.
#
# Both `MALSHARE_DB_*` and `MYSQL_DB_*` key sets are kept populated for app
# compatibility (different parts of the codebase historically read different
# names). Keep the values identical across both sets.
MALSHARE_DB_HOST=mysql
MALSHARE_DB_USER=root
MALSHARE_DB_PASS=your-db-password
MALSHARE_DB_DATABASE=malshare_db
MALSHARE_DB_PORT=3306
MALSHARE_DB_CERT=

MYSQL_DB_HOST=mysql
MYSQL_DB_USER=root
MYSQL_DB_PASS=your-db-password
MYSQL_DB_DATABASE=malshare_db
MYSQL_DB_PORT=3306
MYSQL_DB_CERT=

# === MySQL container init ===
# Consumed by the `mysql` service on first boot only. Must equal MALSHARE_DB_PASS
# above so root@mysql keeps working after the volume is initialised. We use root
# directly (no separate MYSQL_USER) because the official mysql image refuses to
# create a user named `root`.
MYSQL_ROOT_PASSWORD=your-db-password

# === reCAPTCHA ===
MALSHARE_RECAPTCHA_SECRET=your-recaptcha-secret

# === Mailgun (registration emails) ===
MALSHARE_MAILGUN_SMTP=your-mailgun-smtp-host
MALSHARE_MAILGUN_PORT=587
MALSHARE_MAILGUN_FROM=noreply@your-domain.com
MALSHARE_MAILGUN_USERNAME=your-mailgun-username
MALSHARE_MAILGUN_PASSWORD=your-mailgun-password

# === VirusTotal Context Widget ===
VT_CONTEXT_KEY=your-vt-api-key
VT_CONTEXT_URL=https://www.virustotal.com/api/v3/widget/url?mode=standalone&query=

# === Wasabi / S3 Storage ===
WASABI_ENDPOINT=https://s3.wasabisys.com
WASABI_REGION=your-wasabi-region
WASABI_KEY=your-wasabi-access-key
WASABI_SECRET=your-wasabi-secret-key
WASABI_BUCKET=malshare-samples

# === Cloudflare Tunnel ===
TUNNEL_TOKEN=your-cloudflare-tunnel-token
